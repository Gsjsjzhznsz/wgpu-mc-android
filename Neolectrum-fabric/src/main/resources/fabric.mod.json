{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Electrum",
  "description": "A renderer made to replace Blaze3D, written in Rust, using wgpu for cross-platform support. Supported backends: Vulkan, D3D12.",
  "authors": [
    "NoTuring_Steve"
  ],
  "contact": {
    "homepage": "https://github.com/NTS-Official/Neolectrum",
    "issues": "https://github.com/NTS-Official/Neolectrum/issues"
  },
  "license": "MPLv2",
  "icon": "assets/wgpu_mc/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.birb.wgpu.fabric.WgpuMcFabric"
    ]
  },
  "mixins": [
    "wgpu_mc.mixins.json"
  ],
  "accessWidener": "wgpu_mc.accesswidener",
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": "~26.1.2",
    "java": ">=25"
  }
}
